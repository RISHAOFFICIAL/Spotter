{
  "expo": {
    "name": "SPOTTER",
    "slug": "spotter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/icon-source.png",
    "scheme": "spotter",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0C08",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.spotter.mvp",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "SPOTTER uses your camera to capture photo proof of your workouts. Photos are sealed to your account — only you and your partner can ever see them.",
        "NSUserNotificationsUsageDescription": "SPOTTER lets you know when your partner logs a workout and when your invite is accepted. You control every notification type."
      }
    },
    "android": {
      "package": "app.spotter.mvp",
      "icon": "./assets/branding/icon-source.png",
      "adaptiveIcon": {
        "backgroundColor": "#0A0C08",
        "foregroundImage": "./assets/branding/icon-source.png",
        "monochromeImage": "./assets/generated/icons/android/mipmap-xxxhdpi/ic_launcher_monochrome.png"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/generated/icons/web/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/generated/icons/android/mipmap-xxxhdpi/ic_launcher_monochrome.png",
          "color": "#0A0C08",
          "defaultChannel": "spotter-pair",
          "mode": "development"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0C08",
          "image": "./assets/branding/splash-source.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0A0C08",
            "image": "./assets/branding/splash-source.png"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow SPOTTER to use Face ID to unlock your account."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "de189482-0fd9-4471-b273-14d18a9eaee4"
      }
    },
    "owner": "erishasmith0723"
  }
}
