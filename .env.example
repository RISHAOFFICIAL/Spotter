# Copy to `.env` and fill in your Supabase project values to switch from
# DEV MOCK to REAL mode. Removing the file (or leaving it empty) returns the
# app to DEV MOCK (no network). Metro inlines these at start — restart
# `npm start` after changing them.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=